# ---------------------------------------------------------------- credentials
# Produced by: python3 login.py
TGTG_ACCESS_TOKEN=
TGTG_REFRESH_TOKEN=
TGTG_COOKIE=

# ---------------------------------------------------------------- what to watch
TIMEZONE=Europe/Dublin
# Comma-separated item IDs from `python3 watcher.py --list`.
# Leave WATCH_ITEM_IDS empty to watch every favourite you have hearted.
WATCH_ITEM_IDS=
# Only items listed here are ever reserved. Empty = alert only, never reserve.
RESERVE_ITEM_IDS=

# ---------------------------------------------------------------- reserving
# Off by default. Read the "Should you turn this on?" section of the README first.
AUTO_RESERVE=false
RESERVE_QUANTITY=1
# Pay in the app within this many minutes or the watcher releases the bag.
RESERVE_HOLD_MINUTES=6
MAX_RESERVATIONS_PER_DAY=2
# Hours (local) in which the watcher will alert but refuse to reserve.
QUIET_HOURS_START=23
QUIET_HOURS_END=7

# ---------------------------------------------------------------- polling
POLL_SECONDS=90
FAST_POLL_SECONDS=15
MAX_BACKOFF_SECONDS=1800
PAGE_SIZE=50
REQUEST_TIMEOUT=30
# Optional residential proxy, e.g. http://user:pass@host:port
TGTG_PROXY=

# ---------------------------------------------------------------- drop learning
LEARN_MIN_SAMPLES=3
LEARN_WINDOW_PAD_MINUTES=12
LEARN_PREARM_MINUTES=20

# ---------------------------------------------------------------- notifications
# Configure at least one. ntfy is easiest: pick an unguessable topic name,
# install the ntfy app, subscribe to the same topic.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

WEBHOOK_URL=
