# Linux / Raspberry Pi. Install with:
#   sudo cp tgtg-watcher.service /etc/systemd/system/
#   sudo systemctl enable --now tgtg-watcher
# Adjust User= and the paths to match your box.
[Unit]
Description=Too Good To Go bag watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tgtg-watcher
ExecStart=/home/pi/tgtg-watcher/.venv/bin/python /home/pi/tgtg-watcher/watcher.py
Restart=always
RestartSec=60
StandardOutput=append:/home/pi/tgtg-watcher/watcher.log
StandardError=append:/home/pi/tgtg-watcher/watcher.log

[Install]
WantedBy=multi-user.target
